{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "F0-05 benchmark result, one query/deadline/pass",
  "description": "Finite JSON only. Null raw inputs allowed only for invalid fixtures; preserve the diagnostic in input_error. Cross-field and independent FK validation are mandatory.",
  "type": "object",
  "properties": {
    "query_id": {
      "type": "string",
      "minLength": 1
    },
    "query_group_id": {
      "type": "string",
      "minLength": 1
    },
    "query_list_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "solver_config_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset_manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "solver_name": {
      "const": "DLS"
    },
    "solver_version": {
      "const": "0.1.0"
    },
    "target_source": {
      "type": "string",
      "enum": [
        "independent_frozen_fk",
        "analytic_fixture",
        "invalid_fixture"
      ]
    },
    "subset": {
      "type": "string",
      "enum": [
        "main",
        "boundary",
        "singularity",
        "analytic",
        "invalid"
      ]
    },
    "start_class": {
      "type": "string",
      "enum": [
        "local",
        "wide",
        "fixture"
      ]
    },
    "q_current": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "number"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "q_candidate": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "number"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "target_position_m": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "target_quaternion_wxyz": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "position_error_m": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "orientation_error_rad": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 3.141592653589793
        },
        {
          "type": "null"
        }
      ]
    },
    "orientation_error_deg": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        {
          "type": "null"
        }
      ]
    },
    "profile_a_geometry": {
      "type": "boolean"
    },
    "profile_b_geometry": {
      "type": "boolean"
    },
    "joint_limits": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "NOT_AVAILABLE"
      ]
    },
    "collision": {
      "const": "NOT_CHECKED"
    },
    "solver_status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "MAX_ITERATIONS",
        "TIMEOUT",
        "STALLED",
        "NUMERICAL_FAILURE",
        "INVALID_INPUT",
        "UNRESOLVED",
        "PROVEN_UNREACHABLE"
      ]
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "SUCCESS",
        "MAX_ITERATIONS",
        "TIMEOUT",
        "STALLED",
        "NUMERICAL_FAILURE",
        "INVALID_INPUT",
        "UNRESOLVED",
        "PROVEN_UNREACHABLE"
      ]
    },
    "reachability": {
      "type": "string",
      "enum": [
        "KNOWN_REACHABLE",
        "UNRESOLVED",
        "PROVEN_UNREACHABLE"
      ]
    },
    "reachability_proof_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "termination_reason": {
      "type": "string",
      "minLength": 1
    },
    "deadline_profile_ms": {
      "type": "integer",
      "enum": [
        10,
        50
      ]
    },
    "profile_a_deadline": {
      "type": "boolean"
    },
    "profile_b_deadline": {
      "type": "boolean"
    },
    "iterations": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "iteration_availability": {
      "type": "string",
      "enum": [
        "AVAILABLE",
        "NOT_AVAILABLE"
      ]
    },
    "first_profile_a_iteration": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "first_profile_b_iteration": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 200
        },
        {
          "type": "null"
        }
      ]
    },
    "solve_elapsed_ns": {
      "type": "integer",
      "minimum": 0
    },
    "validation_elapsed_ns": {
      "type": "integer",
      "minimum": 0
    },
    "total_elapsed_ns": {
      "type": "integer",
      "minimum": 0
    },
    "measurement_pass_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "thermal_state": {
      "type": "string",
      "enum": [
        "cold",
        "warm"
      ]
    },
    "seeds": {
      "type": "object",
      "properties": {
        "query_seed": {
          "const": 20260925
        },
        "local_start_seed": {
          "const": 20260926
        },
        "wide_start_seed": {
          "const": 20260927
        },
        "boundary_query_seed": {
          "const": 20260928
        },
        "singularity_query_seed": {
          "const": 20260929
        }
      },
      "required": [
        "query_seed",
        "local_start_seed",
        "wide_start_seed",
        "boundary_query_seed",
        "singularity_query_seed"
      ],
      "additionalProperties": false
    },
    "frame": {
      "const": "base_link"
    },
    "tcp": {
      "const": "tool0"
    },
    "quaternion_order": {
      "const": "wxyz"
    },
    "joint_order": {
      "const": [
        "joint_1",
        "joint_2",
        "joint_3",
        "joint_4",
        "joint_5",
        "joint_6"
      ]
    },
    "input_error": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "query_id",
    "query_group_id",
    "query_list_sha256",
    "solver_config_sha256",
    "dataset_manifest_sha256",
    "solver_name",
    "solver_version",
    "target_source",
    "subset",
    "start_class",
    "q_current",
    "q_candidate",
    "target_position_m",
    "target_quaternion_wxyz",
    "position_error_m",
    "orientation_error_rad",
    "orientation_error_deg",
    "profile_a_geometry",
    "profile_b_geometry",
    "joint_limits",
    "collision",
    "solver_status",
    "validation_status",
    "reachability",
    "reachability_proof_sha256",
    "termination_reason",
    "deadline_profile_ms",
    "profile_a_deadline",
    "profile_b_deadline",
    "iterations",
    "iteration_availability",
    "first_profile_a_iteration",
    "first_profile_b_iteration",
    "solve_elapsed_ns",
    "validation_elapsed_ns",
    "total_elapsed_ns",
    "measurement_pass_index",
    "thermal_state",
    "seeds",
    "frame",
    "tcp",
    "quaternion_order",
    "joint_order",
    "input_error"
  ],
  "additionalProperties": false
}
